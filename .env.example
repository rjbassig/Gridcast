# No keys required for CAISO OASIS. Do not put secrets in the dashboard.
GRIDCAST_CONFIG=configs/default.yaml
# Comma-separated browser origins permitted to call the API directly.
GRIDCAST_CORS_ORIGINS=https://gridcast.rjbassig.dev,https://rjbassig.dev,http://localhost:3000,http://127.0.0.1:3000
# Set true for the public, precomputed historical replay release. It disables
# artifact-backed forecast/scenario inference while retaining read-only analytics.
GRIDCAST_REPLAY_ONLY=false
